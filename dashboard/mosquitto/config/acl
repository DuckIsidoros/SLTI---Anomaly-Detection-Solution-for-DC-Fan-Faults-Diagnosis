# ==============================================================================
# Eclipse Mosquitto Access Control List (ACL)
# IEC 62443 Topic Scoping & Zero-Trust Access
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Edge Hardware Node (Physical Microcontroller: esp32_edge_01)
# ------------------------------------------------------------------------------
user edge_node_01
# Allow publishing high-frequency telemetry, alerts, and heartbeats
topic write v1/plant_hcm/line_01/cnc_05/+/+
# Allow publishing Last Will and Testament (LWT) & status
topic write v1/plant_hcm/line_01/cnc_05/status

# ------------------------------------------------------------------------------
# 2. Engineer / Debugger (Used by MQTTX & Development Gateway)
# ------------------------------------------------------------------------------
user layvoduc
# readwrite access allows publishing mock sensor events AND subscribing in MQTTX
topic readwrite v1/plant_hcm/line_01/cnc_05/#
# Allow subscription to plant-level status and alerts
topic read v1/plant_hcm/#

# ------------------------------------------------------------------------------
# 3. Web Application / Dashboard: Read-only access to alert topics
# ------------------------------------------------------------------------------
user dashboard_user
# Matches: v1/<plant>/<line>/<machine>/<sensor>/alert (e.g., v1/plant_hcm/line_01/cnc_05/accelerometer/alert)
topic read v1/+/+/+/+/alert

# ------------------------------------------------------------------------------
# 4. Backend Enterprise Service: Full ingestion pipeline access
# ------------------------------------------------------------------------------
user backend_service
# Read and write access to all pipeline topics for ingestion & orchestration
topic readwrite v1/#
topic readwrite $SYS/#